# -- Arize Phoenix --------------------------------------------------
PHOENIX_HOST=https://app.phoenix.arize.com
PHOENIX_API_KEY=                          # required for Phoenix Cloud only
PHOENIX_PROJECT_NAME=prompt-guardian

# -- Google Cloud ---------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GROQ_API_KEY=gsk_...          # from console.groq.com — for local testing only
USE_GROQ=true                  # set to false to switch back to Gemini for demo
VERTEX_AI_MODEL=gemini-2.0-flash          # only needed for Vertex AI / Cloud Run deployment

# -- Slack ----------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_CHANNEL=#prompt-alerts             # informational only, webhook ignores this

# -- Agent behavior -------------------------------------------------
REGRESSION_THRESHOLD=0.05                # alert if score drops by more than 5 %
EVAL_JUDGE_MODEL=gemini-2.0-flash        # model used as LLM-as-judge
POLL_INTERVAL_SECONDS=300
